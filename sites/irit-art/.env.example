# Manager login for /manage (required in production)
MANAGE_USER=irit
MANAGE_PASSWORD=change-me

# Vercel Blob read/write token — stores content.json + uploaded images in production.
# Leave empty in local dev: content goes to ./data and images to ./public/uploads.
BLOB_READ_WRITE_TOKEN=

# "/irit-art" while served under ansora.io, empty on the artist's own domain.
NEXT_PUBLIC_BASE_PATH=
